<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #86BBD8;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.example.primerparcial.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text=" Bubble Sort Paralelo vs Sec." />

    <Label text="Tamaño del arreglo: x elementos" />

    <Button fx:id="startButton" onAction="#onStartButtonClick" style="-fx-background-color: #33658A;" text="Ordenar" textFill="WHITE" />

    <ProgressIndicator fx:id="progressIndicator" visible="false" />

    <Label fx:id="seqTimeLabel" text="Milis Secuencial: -- ms" />
    <Label fx:id="parTimeLabel" text="Milis Paralelo: -- ms" />
</VBox>
